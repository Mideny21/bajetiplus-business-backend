NODE_ENV=test
APP_NAME=nestjs-backend-starter-test
PORT=3001
API_PREFIX=api/v1
TRUST_PROXY=0
DEV_RESPONSE_DELAY_MS=0
CORS_ORIGINS=http://localhost:3001
