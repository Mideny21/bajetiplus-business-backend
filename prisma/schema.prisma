generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BusinessType {
  PRODUCT
  SERVICE
  HYBRID
}

enum CatalogItemType {
  PRODUCT
  SERVICE
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  CARD
  CREDIT
}

enum InventoryMovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCK_IN
  STOCK_OUT
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String?          @unique
  mobile       String?          @unique
  passwordHash String?
  firebaseUid  String?          @unique
  role         Role             @default(USER)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     RefreshSession[]
  businesses   Business[]
}

model RefreshSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Business {
  id                 String              @id @default(uuid()) @db.Uuid
  ownerId            String              @db.Uuid
  name               String
  industry           String
  type               BusinessType
  currency           String              @default("TZS")
  settings           Json?
  enabledFeatures    String[]            @default([])
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branches           Branch[]
  categories         Category[]
  catalogItems       CatalogItem[]
  productVariants    ProductVariant[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  customers          Customer[]
  suppliers          Supplier[]
  sales              Sale[]
  purchases          Purchase[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]

  @@index([ownerId])
}

model Branch {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  name               String
  isMain             Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  purchases          Purchase[]
  expenses           Expense[]

  @@unique([businessId, name])
  @@index([businessId, isMain])
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  businessId   String        @db.Uuid
  name         String
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  catalogItems CatalogItem[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
}

model CatalogItem {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  categoryId         String?             @db.Uuid
  type               CatalogItemType
  name               String
  description        String?
  sellingPrice       Decimal             @db.Decimal(18, 2)
  costPrice          Decimal?            @db.Decimal(18, 2)
  sku                String?
  trackStock         Boolean             @default(false)
  lowStockThreshold  Decimal?            @db.Decimal(18, 3)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]

  @@unique([businessId, sku])
  @@index([businessId, type, isActive])
  @@index([categoryId])
}

model ProductVariant {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  catalogItemId      String              @db.Uuid
  name               String
  sku                String?
  attributes         Json
  costPrice          Decimal?            @db.Decimal(18, 2)
  sellingPrice       Decimal?            @db.Decimal(18, 2)
  lowStockThreshold  Decimal?            @db.Decimal(18, 3)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  catalogItem        CatalogItem         @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]

  @@unique([businessId, sku])
  @@index([businessId, catalogItemId, isActive])
}

model InventoryBalance {
  id            String          @id @default(uuid()) @db.Uuid
  businessId    String          @db.Uuid
  branchId      String          @db.Uuid
  catalogItemId String          @db.Uuid
  variantId     String?         @db.Uuid
  stockKey      String
  quantity      Decimal         @default(0) @db.Decimal(18, 3)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  catalogItem   CatalogItem     @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([businessId, branchId, catalogItemId, stockKey])
  @@index([businessId, branchId, catalogItemId, variantId])
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  businessId    String                @db.Uuid
  branchId      String                @db.Uuid
  catalogItemId String                @db.Uuid
  variantId     String?               @db.Uuid
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(18, 3)
  balanceAfter  Decimal               @db.Decimal(18, 3)
  referenceType String?
  referenceId   String?               @db.Uuid
  note          String?
  occurredAt    DateTime              @default(now())
  createdAt     DateTime              @default(now())
  branch        Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  catalogItem   CatalogItem           @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  variant       ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([businessId, branchId, catalogItemId, variantId, occurredAt])
  @@index([referenceType, referenceId])
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String
  phone      String
  email      String?
  notes      String?
  balance    Decimal  @default(0) @db.Decimal(18, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sales      Sale[]

  @@index([businessId, isActive])
}

model Supplier {
  id         String     @id @default(uuid()) @db.Uuid
  businessId String     @db.Uuid
  name       String
  phone      String
  email      String?
  notes      String?
  balance    Decimal    @default(0) @db.Decimal(18, 2)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  purchases  Purchase[]

  @@index([businessId, isActive])
}

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @db.Uuid
  branchId      String        @db.Uuid
  customerId    String?       @db.Uuid
  paymentMethod PaymentMethod
  subtotal      Decimal       @db.Decimal(18, 2)
  discount      Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  soldAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         SaleItem[]

  @@index([businessId, soldAt])
  @@index([customerId, soldAt])
}

model SaleItem {
  id               String          @id @default(uuid()) @db.Uuid
  saleId           String          @db.Uuid
  catalogItemId    String          @db.Uuid
  variantId        String?         @db.Uuid
  itemName         String
  variantSnapshot  Json?
  itemType         CatalogItemType
  quantity         Decimal         @db.Decimal(18, 3)
  unitPrice        Decimal         @db.Decimal(18, 2)
  discount         Decimal         @default(0) @db.Decimal(18, 2)
  total            Decimal         @db.Decimal(18, 2)
  unitCostSnapshot Decimal?        @db.Decimal(18, 2)
  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  catalogItem      CatalogItem     @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([catalogItemId])
}

model Purchase {
  id          String         @id @default(uuid()) @db.Uuid
  businessId  String         @db.Uuid
  branchId    String         @db.Uuid
  supplierId  String         @db.Uuid
  totalCost   Decimal        @db.Decimal(18, 2)
  amountPaid  Decimal        @default(0) @db.Decimal(18, 2)
  purchasedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items       PurchaseItem[]

  @@index([businessId, purchasedAt])
  @@index([supplierId, purchasedAt])
}

model PurchaseItem {
  id              String          @id @default(uuid()) @db.Uuid
  purchaseId      String          @db.Uuid
  catalogItemId   String          @db.Uuid
  variantId       String?         @db.Uuid
  itemName        String
  variantSnapshot Json?
  quantity        Decimal         @db.Decimal(18, 3)
  costPerItem     Decimal         @db.Decimal(18, 2)
  totalCost       Decimal         @db.Decimal(18, 2)
  purchase        Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  catalogItem     CatalogItem     @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([catalogItemId])
}

model ExpenseCategory {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  name       String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  expenses   Expense[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  businessId  String          @db.Uuid
  branchId    String          @db.Uuid
  categoryId  String          @db.Uuid
  amount      Decimal         @db.Decimal(18, 2)
  description String?
  incurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([businessId, incurredAt])
  @@index([categoryId])
}
