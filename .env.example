NODE_ENV=development
APP_NAME=nestjs-backend-starter
PORT=3000
API_PREFIX=api/v1
TRUST_PROXY=0
DEV_RESPONSE_DELAY_MS=2000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bajetiplus-business?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_EXPIRES_IN_DAYS=30
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
PHONE_DEFAULT_COUNTRY_CODE=255
LOG_LEVEL=info
# Firebase is optional. Set all three values to enable POST /auth/firebase.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
