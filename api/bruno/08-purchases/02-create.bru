meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/businesses/{{businessId}}/purchases
  body: json
  auth: inherit
}

body:json {
  
    "supplierId": "{{supplierId}}",
    "items": [
      {
        "catalogItemId": "{{catalogItemId}}",
        "quantity": 1,
        "costPerItem": 1000
      }
    ]
  
}
